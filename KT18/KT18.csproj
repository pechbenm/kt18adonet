<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KT18.Charts\KT18.Charts.csproj" />
  </ItemGroup>

  <!-- Отложенная загрузка: сборка не входит в стартовый набор, а подтягивается при переходе на /sales -->
  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="KT18.Charts.wasm" />
  </ItemGroup>

</Project>
